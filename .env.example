# 이 파일을 복사해서 .env 를 만든다.  cp .env.example .env
# .env 는 절대 커밋하지 않는다. (.gitignore에 등록되어 있음)
# 서버(EC2)의 .env 는 CD 워크플로우가 GitHub Secrets로 자동 생성한다.

# 실행할 이미지. 운영 배포는 latest가 아니라 commit SHA tag로 고정한다.
# 서버의 .env는 CD가 배포한 SHA를 기록하므로, 이 값만 보면 어느 커밋이 떠 있는지 알 수 있다.
DOCKER_IMAGE=<도커허브아이디>/team4-backend:<commit-sha>

MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_DATABASE=team4
MYSQL_USER=team4
MYSQL_PASSWORD=change-me

# 최소 32바이트 이상 랜덤 문자열
JWT_SECRET=change-me-to-a-long-random-string

# OpenAI Platform project API key. 실제 값은 로컬 .env와 GitHub production Secret에만 저장한다.
OPENAI_API_KEY=replace-with-openai-project-key
OPENAI_MODEL=gpt-5.4-mini

# 브라우저에서 API를 호출할 프론트엔드 origin 목록. 쉼표로 구분한다.
# scheme, host, port가 정확히 일치하는 값만 허용된다. wildcard(*)는 쓰지 않는다.
# 예) https://team4.example.com,http://localhost:5173
# 값이 비어 있으면 애플리케이션이 시작되지 않는다.
CORS_ALLOWED_ORIGINS=http://localhost:5173
