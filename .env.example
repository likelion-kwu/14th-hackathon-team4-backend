# 이 파일을 복사해서 .env 를 만든다.  cp .env.example .env
# .env 는 절대 커밋하지 않는다. (.gitignore에 등록되어 있음)
# 서버(EC2)의 .env 는 CD 워크플로우가 GitHub Secrets로 자동 생성한다.

# 실행할 이미지. 로컬에서 직접 빌드해 쓸 땐 아래 docker compose build 참고
DOCKER_IMAGE=<도커허브아이디>/team4-backend:latest

MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_DATABASE=team4
MYSQL_USER=team4
MYSQL_PASSWORD=change-me

# 최소 32바이트 이상 랜덤 문자열
JWT_SECRET=change-me-to-a-long-random-string
